generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Booking {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String
  house     String
  dateFrom  DateTime
  dateTo    DateTime
  status    String   @default("pending")
  createdAt DateTime @default(now())
}